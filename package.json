{
  "name": "adara-onboard",
  "version": "0.1.0",
  "private": true,
  "description": "Adara Protocol — Tester Onboarding dApp (served at https://onboard.adara.network)",
  "scripts": {
    "serve": "npx http-server . -p 4173 -c-1 --silent",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-legacy": "^8.0.1",
    "autoprefixer": "^10.5.0",
    "ethers": "^6.16.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "^2.23.9"
  }
}
